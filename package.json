{
  "name": "mashang-hub",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "mashang": "worker/mashang.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "worker": "node worker/worker.mjs",
    "mashang": "node worker/mashang.mjs",
    "runtime:status": "node worker/mashang.mjs status",
    "up": "./scripts/dev.sh start",
    "down": "./scripts/dev.sh stop",
    "restart": "./scripts/dev.sh restart",
    "status": "./scripts/dev.sh status",
    "logs": "./scripts/dev.sh logs",
    "test:dom": "node tests/dom-contract.mjs",
    "test:task-state": "node tests/task-state.mjs",
    "test:artifact": "node tests/artifact-contract.mjs",
    "test:result-contract": "node tests/result-contract.mjs",
    "test:artifact-policy": "node tests/artifact-policy.mjs",
    "test:task-timeout": "node tests/task-timeout.mjs",
    "test:task-log": "node tests/task-log.mjs",
    "test:runtime": "node tests/runtime-registry.mjs && node tests/runtime-jobs.mjs && node tests/runtime-logs.mjs && node tests/runtime-control.mjs",
    "test": "npm run test:dom && npm run test:task-state && npm run test:task-timeout && npm run test:task-log && npm run test:artifact && npm run test:artifact-policy && npm run test:result-contract && npm run test:runtime"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ws": "^8.18.3"
  }
}
